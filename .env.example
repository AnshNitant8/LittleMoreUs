# Browser-only prototype (no server): optional Gemini key. A key in browser
# code is extractable, so this is for local demos only.
VITE_GEMINI_API_KEY=

# ---- Server mode (Vercel + Supabase) ----
# Normally added for you by Vercel's Supabase integration (Storage tab):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, POSTGRES_URL_NON_POOLING
# Add these yourself in Vercel → Settings → Environment Variables:
#   GEMINI_API_KEY=      (server only; never prefix with VITE_)
#   ADMIN_EMAILS=        (comma-separated; can open the admin panel)
#   CRON_SECRET=         (optional; enables the daily clean-up job)
